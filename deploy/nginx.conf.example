# Nginx in front of the booking site. Copy to /etc/nginx/sites-available/urb-booking,
# link it into sites-enabled, then run: sudo certbot --nginx -d urb-booking.co.uk
server {
    listen 80;
    server_name urb-booking.co.uk;

    # Big enough to upload a portable backup on the System page (Backups → Restore from a file).
    client_max_body_size 500m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}

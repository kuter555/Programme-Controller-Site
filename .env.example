# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# The shared admin passphrase. It can also be changed later on the /system page.
# Changing it here and restarting always works too — that's the way back in if
# nobody remembers it. Use something only the Programme Controller / Station Manager knows.
ADMIN_PASSPHRASE=change-this-passphrase

# Port the server listens on.
PORT=3000

# The site's public address — used by the health checks on /system (domain expiry,
# DNS, HTTPS certificate). Can also be changed on the /system page.
PUBLIC_URL=https://urb-booking.co.uk

# Optional: where nightly backups go (default: data/backups).
# BACKUP_DIR=/var/backups/urb-booking

# Optional but recommended: a second folder, ideally on another disk or a mounted
# network drive, that every backup is also copied to.
# BACKUP_MIRROR_DIR=/mnt/offsite/urb-booking

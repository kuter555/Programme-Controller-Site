# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# The shared admin passphrase. Whatever you put here becomes (or updates) the
# admin passphrase every time the server starts. Change this to something
# only the Programme Controller / Station Manager knows.
ADMIN_PASSPHRASE=change-this-passphrase

# Port the server listens on.
PORT=3000

# Public address of the site, used in emailed links (e.g. https://book.urb.example).
# If unset, links use whatever address the request came in on.
APP_URL=

# SMTP for member account emails (set-password / reset links).
# Leave SMTP_HOST empty to print emails to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="URB Studio Booking <no-reply@example.com>"
